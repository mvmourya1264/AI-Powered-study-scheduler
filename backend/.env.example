# JWT signing secret — required in production
SECRET_KEY=change-me-to-a-long-random-string

# Optional: Postgres connection string (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:pass@localhost/study_scheduler

# Google Gemini API key — required for image syllabus uploads and recommended for PDFs
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
